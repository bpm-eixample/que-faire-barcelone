---
import { useTranslations, localizePath, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  slug: string;
  title: string;
  summary: string;
  category: string;
  area: string;
  duration?: string;
  price?: string;
  emoji?: string;
  image?: string;
}
const { lang, slug, title, summary, category, area, duration, price, emoji = '📍', image } = Astro.props;
const t = useTranslations(lang);
---

<article class="card">
  <a class="thumb" href={localizePath(lang, `activites/${slug}`)} aria-label={title}>
    {image
      ? <img src={image} alt={title} loading="lazy" />
      : <div class="ph" style="background: linear-gradient(135deg,#fff4d6,#f7e3ae);">{emoji}</div>}
  </a>
  <div class="body">
    <span class="tag">{category}</span>
    <h3><a href={localizePath(lang, `activites/${slug}`)} style="color:inherit">{title}</a></h3>
    <p>{summary}</p>
    <div class="meta">
      <span>📍 {area}</span>
      {duration && <span>⏱️ {duration}</span>}
      {price && <span>💶 {price}</span>}
    </div>
    <div class="card-foot">
      <a class="link-more" href={localizePath(lang, `activites/${slug}`)}>{t('common.readMore')}</a>
    </div>
  </div>
</article>

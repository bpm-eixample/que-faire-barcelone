---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, allLangs, defaultLang, type Lang } from '../../i18n/utils';

export function getStaticPaths() {
  return allLangs.map((lang) => ({ params: { lang } }));
}

const lang = (Astro.params.lang ?? defaultLang) as Lang;
const t = useTranslations(lang);

interface Section { h: string; p: string[]; }
const content: Record<Lang, { title: string; intro: string; sections: Section[]; note: string }> = {
  fr: {
    title: 'Mentions légales & affiliation',
    intro: 'Informations légales relatives au site « Que Faire à Barcelone ».',
    note: 'Dernière mise à jour : 1er juin 2026. En cas de doute juridique, consultez un professionnel du droit.',
    sections: [
      { h: 'Éditeur du site', p: [
        'Le site « Que Faire à Barcelone » (quefaireabarcelone.com) est édité à titre non professionnel par un particulier.',
        'Conformément à l\'article 6-III-2 de la Loi n° 2004-575 du 21 juin 2004 pour la Confiance dans l\'Économie Numérique (LCEN), l\'identité complète du responsable de la publication est communiquée à l\'hébergeur et peut être obtenue sur réquisition judiciaire.',
        'Contact éditorial : contact@quefaireabarcelone.com',
      ] },
      { h: 'Hébergement', p: [
        'Le site est hébergé par Netlify, Inc. — 44 Montgomery Street, Suite 300, San Francisco, CA 94104, États-Unis — https://www.netlify.com/',
      ] },
      { h: 'Liens d’affiliation', p: [
        'Ce site contient des liens d’affiliation, notamment vers GetYourGuide, Booking.com, Welcome Pickups et Airalo.',
        'Si vous effectuez une réservation ou un achat via ces liens, nous pouvons percevoir une commission, sans aucun surcoût pour vous. Ces commissions contribuent à financer le site.',
        'Nos recommandations restent indépendantes et fondées sur l’intérêt des voyageurs.',
      ] },
      { h: 'Publicité', p: [
        'Le site est susceptible d’afficher des annonces publicitaires (par exemple via Google AdSense). Ces services tiers peuvent déposer des cookies sur votre appareil, uniquement après votre consentement via le bandeau prévu à cet effet.',
      ] },
      { h: 'Propriété intellectuelle', p: [
        'Les contenus du site (textes, structure, mises en page) sont la propriété de l’éditeur, sauf mention contraire.',
        'Certaines photographies proviennent de Wikimedia Commons et d’Unsplash, sous leurs licences respectives (voir le fichier de crédits des images).',
      ] },
      { h: 'Données personnelles & cookies', p: [
        'Le site fait appel à des services tiers (GetYourGuide, Google, etc.) susceptibles d’utiliser des cookies à des fins de fonctionnement, de mesure d’audience ou de publicité. Un bandeau de consentement (Google Consent Mode v2) vous permet d\'accepter ou de refuser ces cookies.',
        'Conformément au Règlement Général sur la Protection des Données (RGPD) et à la loi Informatique et Libertés, vous disposez d’un droit d’accès, de rectification, de suppression et d\'opposition concernant vos données. Pour toute demande : contact@quefaireabarcelone.com.',
      ] },
    ],
  },
  en: {
    title: 'Legal notice & affiliate disclosure',
    intro: 'Legal information about the “What To Do in Barcelona” website.',
    note: 'Last updated: June 1, 2026. If you have any legal questions, please consult a qualified professional.',
    sections: [
      { h: 'Site publisher', p: [
        'The “What To Do in Barcelona” website (quefaireabarcelone.com) is published on a non-professional basis by a private individual.',
        'In accordance with Article 6-III-2 of French Law No. 2004-575 (LCEN) and applicable EU regulations, the publisher’s full identity is on file with the hosting provider and may be disclosed upon lawful request.',
        'Editorial contact: contact@quefaireabarcelone.com',
      ] },
      { h: 'Hosting', p: [
        'The website is hosted by Netlify, Inc. — 44 Montgomery Street, Suite 300, San Francisco, CA 94104, USA — https://www.netlify.com/',
      ] },
      { h: 'Affiliate links', p: [
        'This site contains affiliate links, notably to GetYourGuide, Booking.com, Welcome Pickups and Airalo.',
        'If you make a booking or purchase through these links, we may earn a commission at no extra cost to you. These commissions help fund the site.',
        'Our recommendations remain independent and based on travellers’ best interests.',
      ] },
      { h: 'Advertising', p: [
        'The site may display advertising (for example via Google AdSense). These third-party services may place cookies on your device, only after your consent via the dedicated banner.',
      ] },
      { h: 'Intellectual property', p: [
        'The site’s content (texts, structure, layouts) is the property of the publisher, unless otherwise stated.',
        'Some photographs come from Wikimedia Commons and Unsplash, under their respective licences (see the image credits file).',
      ] },
      { h: 'Personal data & cookies', p: [
        'The site uses third-party services (GetYourGuide, Google, etc.) that may use cookies for functionality, analytics or advertising purposes. A consent banner (Google Consent Mode v2) lets you accept or decline these cookies.',
        'In accordance with the GDPR, you have the right to access, rectify, delete and object to the processing of your data. For any request: contact@quefaireabarcelone.com.',
      ] },
    ],
  },
  es: {
    title: 'Aviso legal y afiliación',
    intro: 'Información legal sobre el sitio web «Qué Hacer en Barcelona».',
    note: 'Última actualización: 1 de junio de 2026. En caso de duda jurídica, consulta a un profesional del derecho.',
    sections: [
      { h: 'Editor del sitio', p: [
        'El sitio «Qué Hacer en Barcelona» (quefaireabarcelone.com) es editado a título no profesional por un particular.',
        'De conformidad con el artículo 6-III-2 de la Ley francesa n° 2004-575 (LCEN) y la normativa europea aplicable, la identidad completa del responsable de la publicación está registrada en el proveedor de alojamiento y puede ser facilitada por requerimiento judicial.',
        'Contacto editorial: contact@quefaireabarcelone.com',
      ] },
      { h: 'Alojamiento', p: [
        'El sitio está alojado por Netlify, Inc. — 44 Montgomery Street, Suite 300, San Francisco, CA 94104, EE. UU. — https://www.netlify.com/',
      ] },
      { h: 'Enlaces de afiliación', p: [
        'Este sitio contiene enlaces de afiliación, en particular a GetYourGuide, Booking.com, Welcome Pickups y Airalo.',
        'Si realizas una reserva o compra a través de estos enlaces, podemos recibir una comisión, sin coste adicional para ti. Estas comisiones ayudan a financiar el sitio.',
        'Nuestras recomendaciones son independientes y se basan en el interés de los viajeros.',
      ] },
      { h: 'Publicidad', p: [
        'El sitio puede mostrar anuncios publicitarios (por ejemplo, mediante Google AdSense). Estos servicios de terceros pueden instalar cookies en tu dispositivo, únicamente tras tu consentimiento a través del banner previsto a tal efecto.',
      ] },
      { h: 'Propiedad intelectual', p: [
        'Los contenidos del sitio (textos, estructura, maquetación) son propiedad del editor, salvo indicación contraria.',
        'Algunas fotografías proceden de Wikimedia Commons y Unsplash, bajo sus respectivas licencias (consulta el archivo de créditos de las imágenes).',
      ] },
      { h: 'Datos personales y cookies', p: [
        'El sitio utiliza servicios de terceros (GetYourGuide, Google, etc.) que pueden usar cookies con fines de funcionamiento, analítica o publicidad. Un banner de consentimiento (Google Consent Mode v2) te permite aceptar o rechazar estas cookies.',
        'De acuerdo con el Reglamento General de Protección de Datos (RGPD), tienes derecho a acceder, rectificar, suprimir y oponerte al tratamiento de tus datos. Para cualquier solicitud: contact@quefaireabarcelone.com.',
      ] },
    ],
  },
};

const c = content[lang];
---

<BaseLayout lang={lang} path="mentions" title={c.title} description={c.intro}>
  <section class="page-head">
    <div class="container">
      <span class="eyebrow" style="color:var(--c-terracotta);font-weight:700;text-transform:uppercase;letter-spacing:.12em;font-size:.78rem;">{t('footer.legal')}</span>
      <h1>{c.title}</h1>
      <p>{c.intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <article class="prose">
        {c.sections.map((s) => (
          <>
            <h2>{s.h}</h2>
            {s.p.map((para) => <p>{para}</p>)}
          </>
        ))}
        <p style="margin-top:2rem;color:var(--c-muted);font-size:.9rem;font-style:italic;">{c.note}</p>
      </article>
    </div>
  </section>
</BaseLayout>

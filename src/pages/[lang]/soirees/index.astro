---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations, allLangs, defaultLang, type Lang } from '../../../i18n/utils';

export function getStaticPaths() {
  return allLangs.map((lang) => ({ params: { lang } }));
}

const lang = (Astro.params.lang ?? defaultLang) as Lang;
const t = useTranslations(lang);

// Les soirées viennent de l'API du calendrier (Cloudflare Worker, mise à jour automatique)
const API = 'https://nuits-barcelone.bpmbar-barcelona.workers.dev/api/events';

const L = {
  fr: {
    weeks: ['Cette semaine', 'Semaine prochaine', 'Dans 2 semaines', 'Dans 3 semaines', 'Tout le mois'],
    week: 'Semaine', days: ['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi', 'Dimanche'], ds: ['Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam', 'Dim'],
    months: ['janv.', 'févr.', 'mars', 'avr.', 'mai', 'juin', 'juil.', 'août', 'sept.', 'oct.', 'nov.', 'déc.'],
    cats: { disco: 'Disco gratuite', pong: 'Beer pong', social: 'Soirée sociale / Erasmus', lang: 'Language exchange', club: 'Club (payant)' },
    tonight: 'CE SOIR', free: 'discos gratuites', confirmed: 'Confirmé', recurring: 'Récurrent', special: 'Spécial', go: "S'inscrire / infos",
    none: 'Aucune soirée pour ces filtres.', loading: 'Chargement des soirées…', error: 'Impossible de charger les soirées. Rechargez la page dans un instant.', updated: 'Actualisé le',
    listsTitle: 'Les listes gratuites', tipsTitle: 'À savoir', locale: 'fr-FR',
    tips: [
      '<b>Confirmé</b> : soirée publiée pour cette date par la liste. <b>Récurrent</b> : soirée habituelle de ce jour de la semaine, à confirmer.',
      "<b>Inscrivez-vous avant</b> : votre nom est vérifié à la porte. Arrivez avant l'heure limite (souvent 01:00–01:30), sinon l'entrée coûte 15–25 €.",
      '<b>Dress code</b> : smart casual. Baskets propres OK ; tongs, shorts de plage, maillots de foot et tenue de sport refusés.',
      "<b>18+</b> partout, <b>21+</b> à Noxe (W Hotel). Pièce d'identité obligatoire.",
    ],
  },
  en: {
    weeks: ['This week', 'Next week', 'In 2 weeks', 'In 3 weeks', 'Whole month'],
    week: 'Week', days: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'], ds: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
    months: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
    cats: { disco: 'Free club', pong: 'Beer pong', social: 'Social / Erasmus', lang: 'Language exchange', club: 'Club (paid)' },
    tonight: 'TONIGHT', free: 'free clubs', confirmed: 'Confirmed', recurring: 'Recurring', special: 'Special', go: 'Sign up / info',
    none: 'No parties for these filters.', loading: 'Loading parties…', error: 'Could not load the parties. Please reload in a moment.', updated: 'Updated',
    listsTitle: 'The free guest lists', tipsTitle: 'Good to know', locale: 'en-GB',
    tips: [
      '<b>Confirmed</b>: published for this exact date by the list. <b>Recurring</b>: usual party on this weekday, to be confirmed.',
      '<b>Sign up beforehand</b>: your name is checked at the door. Arrive before the cut-off (usually 01:00–01:30), otherwise entry costs €15–25.',
      '<b>Dress code</b>: smart casual. Clean sneakers are fine; flip-flops, beach shorts, football shirts and sportswear are refused.',
      '<b>18+</b> everywhere, <b>21+</b> at Noxe (W Hotel). ID required.',
    ],
  },
  es: {
    weeks: ['Esta semana', 'Próxima semana', 'En 2 semanas', 'En 3 semanas', 'Todo el mes'],
    week: 'Semana', days: ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'], ds: ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'],
    months: ['ene.', 'feb.', 'mar.', 'abr.', 'may.', 'jun.', 'jul.', 'ago.', 'sept.', 'oct.', 'nov.', 'dic.'],
    cats: { disco: 'Discoteca gratis', pong: 'Beer pong', social: 'Social / Erasmus', lang: 'Intercambio de idiomas', club: 'Club (de pago)' },
    tonight: 'ESTA NOCHE', free: 'discotecas gratis', confirmed: 'Confirmado', recurring: 'Habitual', special: 'Especial', go: 'Apuntarse / info',
    none: 'No hay fiestas para estos filtros.', loading: 'Cargando fiestas…', error: 'No se han podido cargar las fiestas. Recarga la página en un momento.', updated: 'Actualizado el',
    listsTitle: 'Las listas gratis', tipsTitle: 'Bueno saberlo', locale: 'es-ES',
    tips: [
      '<b>Confirmado</b>: publicado por la lista para esta fecha. <b>Habitual</b>: fiesta habitual de ese día de la semana, por confirmar.',
      '<b>Apúntate antes</b>: comprueban tu nombre en la puerta. Llega antes de la hora límite (normalmente 01:00–01:30), si no la entrada cuesta 15–25 €.',
      '<b>Dress code</b>: smart casual. Zapatillas limpias OK; chanclas, bañador, camisetas de fútbol y ropa deportiva, no.',
      '<b>+18</b> en todas, <b>+21</b> en Noxe (W Hotel). DNI o pasaporte obligatorio.',
    ],
  },
}[lang];

const LIST_NAMES = ['AASHI LIST', 'SHAZ LIST', 'WELOVEBCN', 'THUNDER LIST', 'PARTYKAZU'];
---

<BaseLayout lang={lang} path="soirees" title={t('page.soirees.title')} description={t('page.soirees.intro')}>
  <section class="page-head">
    <div class="container">
      <span class="eyebrow" style="color:var(--c-terracotta);font-weight:600;text-transform:uppercase;letter-spacing:.14em;font-size:.78rem;">{t('nav.soirees')}</span>
      <h1>{t('page.soirees.title')}</h1>
      <p>{t('page.soirees.intro')}</p>
      <p class="nb-stamp" id="nb-stamp">{L.loading}</p>
    </div>
  </section>

  <section class="section nb">
    <div class="container nb-wrap">
      <div class="nb-bar">
        <div class="nb-weeks" id="nb-weeks" role="group"></div>
        <div class="nb-days" id="nb-days" role="group"></div>
        <div class="blog-filters nb-filters" id="nb-filters" role="group"></div>
      </div>

      <div id="nb-out"><p class="nb-empty">{L.loading}</p></div>

      <h2 class="nb-h2">{L.listsTitle}</h2>
      <p class="nb-listnames">{LIST_NAMES.join(' · ')}</p>
      <div class="nb-lists" id="nb-lists"></div>

      <h2 class="nb-h2">{L.tipsTitle}</h2>
      <ul class="nb-tips">
        {L.tips.map((tip) => <li set:html={tip} />)}
      </ul>
    </div>
  </section>

  <style is:global>
    .nb-wrap { max-width: 900px; }
    .nb-stamp { font-size: .85rem; color: var(--c-muted); margin-top: .6rem; }
    .nb-bar { background: var(--c-cream); padding: .7rem 0; display: grid; gap: .6rem; border-bottom: 1px solid var(--c-line); margin-bottom: 1.2rem; }
    .nb-weeks, .nb-days { display: flex; gap: .4rem; }
    .nb-weeks, .nb-days, .nb-filters { overflow-x: auto; scrollbar-width: none; flex-wrap: nowrap !important; }
    .nb-weeks button, .nb-days button { font: inherit; cursor: pointer; border: 1px solid var(--c-line); background: var(--c-surface); color: var(--c-ink); border-radius: 999px; white-space: nowrap; padding: .35rem .85rem; font-size: .9rem; }
    .nb-weeks button { font-size: .82rem; background: transparent; color: var(--c-muted); border-radius: 8px; }
    .nb-weeks button[aria-pressed="true"] { color: var(--c-ink); border-color: var(--c-ink); font-weight: 600; }
    .nb-days button[aria-pressed="true"] { background: var(--c-terracotta); border-color: var(--c-terracotta); color: #fff; }
    .nb-days .dt, .nb-weeks .dt { font-size: .75rem; opacity: .8; margin-left: .3rem; }
    .nb-filters { margin: 0; justify-content: flex-start; max-width: none; }
    .nb-filters .chip-filter { display: inline-flex; align-items: center; gap: .4rem; white-space: nowrap; flex: none; font-size: .82rem; padding: .3rem .75rem; }
    .nb-filters .chip-filter[aria-pressed="false"] { opacity: .45; background: var(--c-surface); color: var(--c-ink); border-color: var(--c-line); box-shadow: none; }
    .nb-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--k); }
    .nb-day { display: grid; gap: .6rem; margin-bottom: 1.6rem; }
    .nb-day h2 { font-size: 1.5rem; margin: .4rem 0 .1rem; display: flex; flex-wrap: wrap; align-items: baseline; gap: .6rem; }
    .nb-day h2 .when { font-weight: 500; font-size: 1rem; color: var(--c-muted); }
    .nb-day h2 small { font-size: .75rem; font-weight: 600; color: var(--c-muted); letter-spacing: .05em; }
    .nb-day h2 small.today { color: var(--c-terracotta); }
    .nb-ev { display: grid; grid-template-columns: 58px 1fr; gap: .2rem .9rem; background: var(--c-surface); border: 1px solid var(--c-line); border-left: 4px solid var(--k); border-radius: var(--radius-sm); padding: .8rem .95rem; }
    .nb-ev .t { font-variant-numeric: tabular-nums; color: var(--c-muted); font-size: .88rem; padding-top: .15rem; }
    .nb-ev .main { min-width: 0; display: grid; gap: .25rem; }
    .nb-ev .name { font-weight: 600; font-size: 1.02rem; margin-right: .5rem; }
    .nb-ev .where { color: var(--c-muted); font-size: .88rem; }
    .nb-ev .cond { font-size: .93rem; }
    .nb-tags { display: flex; flex-wrap: wrap; gap: .4rem; align-items: center; }
    .nb-tag { font-size: .72rem; letter-spacing: .03em; padding: .1rem .5rem; border-radius: 5px; border: 1px solid var(--c-line); color: var(--c-muted); }
    .nb-tag.list { color: var(--c-ink); border-color: var(--k); }
    .nb-badge { font-size: .68rem; text-transform: uppercase; letter-spacing: .05em; padding: .1rem .45rem; border-radius: 4px; background: var(--k); color: #fff; }
    .nb-badge.rec { background: transparent; color: var(--c-muted); border: 1px dashed var(--c-line); }
    .nb-ev a.go { font-size: .85rem; font-weight: 600; color: var(--k); }
    .nb-empty { color: var(--c-muted); font-style: italic; }
    .nb-h2 { font-size: 1.6rem; margin: 2.4rem 0 .8rem; }
    .nb-listnames { color: var(--c-muted); font-size: .9rem; margin-top: -.4rem; }
    .nb-lists { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: .8rem; }
    .nb-lists > div { background: var(--c-surface); border: 1px solid var(--c-line); border-radius: var(--radius-sm); padding: .9rem; display: grid; gap: .3rem; align-content: start; min-width: 0; }
    .nb-lists h3 { font-size: 1.05rem; margin: 0; }
    .nb-lists p { margin: 0; font-size: .88rem; color: var(--c-muted); }
    .nb-lists a { color: var(--c-gold-vif); font-weight: 600; font-size: .88rem; word-break: break-word; }
    .nb-tips { color: var(--c-muted); display: grid; gap: .4rem; padding-left: 1.2rem; }
    .nb-tips b { color: var(--c-ink); }
    .k-disco { --k: #9b6bff; } .k-pong { --k: #1fc48a; } .k-social { --k: #ff9d2e; } .k-club { --k: #ff4f8b; } .k-lang { --k: #4aa3ff; }
    @media (min-width: 760px) { .nb-bar { position: sticky; top: 70px; z-index: 5; } }
    @media (max-width: 560px) { .nb-ev { grid-template-columns: 1fr; } }
  </style>

  <script is:inline define:vars={{ API, L, LANG: lang }}>
    (function () {
      var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); };
      var safeUrl = function (u) { return /^https:\/\//.test(u) ? u : '#'; };
      // Champs traduits fournis par l'API (n_en, c_es…), repli sur le français
      var loc = function (e, f) { return (LANG !== 'fr' && e[f + '_' + LANG]) || e[f]; };
      var fmt = function (iso) { var p = iso.split('-').map(Number); return LANG === 'en' ? L.months[p[1] - 1] + ' ' + p[2] : p[2] + ' ' + L.months[p[1] - 1]; };
      var wd = function (iso) { return (new Date(iso + 'T12:00:00Z').getUTCDay() + 6) % 7; };
      var today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Madrid' }).format(new Date());
      var DATA = null, week = 0, sel = null, on = Object.keys(L.cats);
      var $ = function (id) { return document.getElementById(id); };
      var weekDays = function (w) { return DATA.days.slice(w * 7, w * 7 + 7); };
      var press = function (cond) { return cond ? 'true' : 'false'; };

      function renderBar() {
        $('nb-weeks').innerHTML = L.weeks.map(function (x, i) {
          var v = i === 4 ? -1 : i, lab = esc(x);
          if (v >= 0) { var d = weekDays(v); lab += ' <span class="dt">' + fmt(d[0].date) + ' – ' + fmt(d[6].date) + '</span>'; }
          return '<button type="button" data-w="' + v + '" aria-pressed="' + press(v === week) + '">' + lab + '</button>';
        }).join('');
        $('nb-weeks').querySelectorAll('button').forEach(function (b) { b.onclick = function () { week = +b.dataset.w; sel = null; renderBar(); render(); }; });
        var dEl = $('nb-days');
        if (week < 0) { dEl.hidden = true; } else {
          dEl.hidden = false;
          dEl.innerHTML = '<button type="button" data-s="" aria-pressed="' + press(sel === null) + '">' + esc(L.week) + '</button>' + weekDays(week).map(function (d) {
            return '<button type="button" data-s="' + d.date + '" aria-pressed="' + press(sel === d.date) + '">' + L.ds[wd(d.date)] + '<span class="dt">' + fmt(d.date) + '</span></button>';
          }).join('');
          dEl.querySelectorAll('button').forEach(function (b) { b.onclick = function () { sel = b.dataset.s || null; renderBar(); render(); }; });
        }
        $('nb-filters').innerHTML = Object.keys(L.cats).map(function (k) {
          return '<button type="button" class="chip-filter k-' + k + (on.indexOf(k) >= 0 ? ' is-active' : '') + '" data-k="' + k + '" aria-pressed="' + press(on.indexOf(k) >= 0) + '"><span class="nb-dot"></span>' + esc(L.cats[k]) + '</button>';
        }).join('');
        $('nb-filters').querySelectorAll('button').forEach(function (b) { b.onclick = function () { var k = b.dataset.k, i = on.indexOf(k); if (i >= 0) on.splice(i, 1); else on.push(k); renderBar(); render(); }; });
      }
      function ev(e) {
        var tags = (e.l || []).map(function (x) { return '<span class="nb-tag list">' + esc((DATA.lists[x] || {}).n || x) + '</span>'; }).join('');
        var badge = e.live ? '<span class="nb-badge">' + L.confirmed + '</span>' : e.special ? '<span class="nb-badge">' + L.special + '</span>' : '<span class="nb-badge rec">' + L.recurring + '</span>';
        return '<article class="nb-ev k-' + esc(e.k) + '"><div class="t">' + esc(e.t) + '</div><div class="main">' +
          '<div><span class="name">' + esc(loc(e, 'n')) + '</span><span class="where">' + esc(loc(e, 'w')) + '</span></div>' +
          '<div class="cond">' + esc(loc(e, 'c')) + '</div>' +
          '<div class="nb-tags">' + badge + '<span class="nb-tag">' + esc(L.cats[e.k] || e.k) + '</span>' + tags +
          '<a class="go" href="' + esc(safeUrl(e.u)) + '" target="_blank" rel="noopener nofollow">' + L.go + ' ↗</a></div></div></article>';
      }
      function render() {
        var days = week < 0 ? DATA.days : weekDays(week);
        if (sel) days = days.filter(function (d) { return d.date === sel; });
        $('nb-out').innerHTML = days.map(function (d) {
          var list = d.events.filter(function (e) { return on.indexOf(e.k) >= 0; });
          var nd = d.events.filter(function (e) { return e.k === 'disco'; }).length;
          return '<section class="nb-day"><h2>' + L.days[wd(d.date)] + ' <span class="when">' + fmt(d.date) + '</span>' +
            (d.date === today ? ' <small class="today">' + L.tonight + '</small>' : '') + '<small>' + nd + ' ' + L.free + '</small></h2>' +
            (list.map(ev).join('') || '<p class="nb-empty">' + L.none + '</p>') + '</section>';
        }).join('');
      }
      fetch(API, { cache: 'reload' }).then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); }).then(function (d) {
        DATA = d;
        var i = DATA.days.findIndex(function (x) { return x.date === today; });
        week = i >= 0 ? Math.floor(i / 7) : 0; sel = i >= 0 ? today : null;
        $('nb-lists').innerHTML = Object.keys(DATA.lists).map(function (k) { var x = DATA.lists[k];
          return '<div><h3>' + esc(x.n) + '</h3><p>' + esc(loc(x, 'd')) + '</p><a href="' + esc(safeUrl(x.u)) + '" target="_blank" rel="noopener nofollow">' + esc(x.u.replace(/^https:\/\/(www\.)?/, '').replace(/\/$/, '')) + ' ↗</a></div>'; }).join('');
        var g = new Date(DATA.generated).toLocaleString(L.locale, { timeZone: 'Europe/Madrid', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
        $('nb-stamp').textContent = L.updated + ' ' + g;
        renderBar(); render();
      }).catch(function () { $('nb-out').innerHTML = '<p class="nb-empty">' + L.error + '</p>'; $('nb-stamp').textContent = ''; });
    })();
  </script>
</BaseLayout>
